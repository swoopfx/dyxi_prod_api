<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dyxi API Documentation</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Swagger UI CSS -->
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/swagger-ui-dist@5.11.0/swagger-ui.css">
    
    <!-- Premium Dark Theme & Micro-animations -->
    <style>
        :root {
            --bg-color: #0b0f19;
            --card-bg: rgba(22, 30, 49, 0.7);
            --border-color: rgba(255, 255, 255, 0.08);
            --primary-color: #3b82f6;
            --text-color: #f1f5f9;
            --text-muted: #94a3b8;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background-image: 
                radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.12) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(147, 51, 234, 0.12) 0px, transparent 50%);
            background-attachment: fixed;
        }

        /* Top Header Navigation */
        .api-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 2rem;
            background: rgba(11, 15, 25, 0.6);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .api-brand {
            font-family: 'Outfit', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #60a5fa 0%, #c084fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .api-brand span {
            font-size: 0.875rem;
            padding: 0.25rem 0.6rem;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--border-color);
            border-radius: 9999px;
            color: var(--text-color);
            -webkit-text-fill-color: initial;
            font-weight: 500;
            font-family: 'Inter', sans-serif;
        }

        .back-link {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .back-link:hover {
            color: var(--text-color);
            transform: translateX(-2px);
        }

        /* Swagger UI Overrides for Premium Dark Mode */
        .swagger-ui {
            filter: invert(0.9) hue-rotate(180deg);
        }
        
        .swagger-ui .topbar {
            display: none;
        }

        .swagger-ui .info {
            margin: 40px 0;
        }

        .swagger-ui .info .title {
            color: #fff;
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
        }

        .swagger-ui .info p, 
        .swagger-ui .info li, 
        .swagger-ui .info table {
            color: #ccc;
        }

        .swagger-ui .scheme-container {
            background: transparent;
            box-shadow: none;
            border-bottom: 1px solid rgba(0,0,0,0.1);
            padding: 20px 0;
        }

        /* Clean up contrast and colors */
        .swagger-ui .opblock {
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            border: 1px solid rgba(0, 0, 0, 0.15) !important;
            overflow: hidden;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .swagger-ui .opblock:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2), 0 4px 6px -2px rgba(0, 0, 0, 0.1);
        }

        .swagger-ui .opblock .opblock-summary {
            padding: 12px 20px;
        }

        .swagger-ui .opblock .opblock-summary-method {
            border-radius: 6px;
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
        }

        .swagger-ui .btn {
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .swagger-ui input[type=text], 
        .swagger-ui select {
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.2);
            color: #fff;
        }

        /* Restore original colors for response/request payload syntax highlighting and images */
        .swagger-ui .microlight,
        .swagger-ui img,
        .swagger-ui .highlight-code {
            filter: invert(1) hue-rotate(180deg);
        }
    </style>
</head>
<body>
    <header class="api-header">
        <div class="api-brand">
            Dyxi API <span>v1.0.0</span>
        </div>
        <a href="/" class="back-link">
            ← Back to Home
        </a>
    </header>

    <div id="swagger-ui"></div>

    <!-- Swagger UI JS Bundle -->
    <script src="https://unpkg.com/swagger-ui-dist@5.11.0/swagger-ui-bundle.js"></script>
    <script src="https://unpkg.com/swagger-ui-dist@5.11.0/swagger-ui-standalone-preset.js"></script>
    <script>
        window.onload = function() {
            const ui = SwaggerUIBundle({
                url: "/api/docs/json",
                dom_id: '#swagger-ui',
                deepLinking: true,
                presets: [
                    SwaggerUIBundle.presets.apis,
                    SwaggerUIStandalonePreset
                ],
                plugins: [
                    SwaggerUIBundle.plugins.DownloadUrl
                ],
                layout: "BaseLayout",
                persistAuthorization: true
            });
            window.ui = ui;
        };
    </script>
</body>
</html>
