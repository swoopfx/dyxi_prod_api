                <?php for ($p = 1; $p <= $totalPages; $p++): ?>
                    <a href="<?= $this->url('game-admin-games') ?>?page=<?= $p ?><?= $queryParamsStr ?>" class="<?= $p === $page ? 'ga-btn-primary' : 'ga-btn-secondary' ?>" style="padding: 6px 12px; min-width: 36px; text-align: center;">
                        <?= $p ?>
                    </a>
                <?php endfor; ?>

                <?php if ($page < $totalPages): ?>
