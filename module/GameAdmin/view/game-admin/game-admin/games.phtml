$pagination = $this->pagination ?? ['page' => 1, 'limit' => 10, 'total' => count($this->games), 'totalPages' => 1, 'q' => '', 'column' => 'all', 'game_type_id' => ''];
$page            = (int) $pagination['page'];
$totalPages      = (int) $pagination['totalPages'];
$total           = (int) $pagination['total'];
$q               = (string) $pagination['q'];
$column          = (string) ($pagination['column'] ?? 'all');
$selectedTypeId  = (string) ($pagination['game_type_id'] ?? '');
$gameTypeOptions = $this->gameTypeOptions ?? [];

$queryString = http_build_query(array_filter([
    'q'            => $q,
    'column'       => $column !== 'all' ? $column : null,
    'game_type_id' => $selectedTypeId ?: null,
]));
$queryParamsStr = !empty($queryString) ? '&' . $queryString : '';
?>

