            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <button type="button" class="btn btn-paystack" id="paystackPayBtn" onclick="triggerPaystackPayment()">
                    💳 Pay Now via Paystack (Nigeria)
                </button>
                <button type="button" class="btn" style="background: rgba(16, 185, 129, 0.2); color: #6ee7b7; border: 1px solid rgba(16,185,129,0.3);" onclick="simulatePaystackSuccess()">
                    ⚡ Instant Test Payment (Simulate Paystack Callback)
                </button>
                <button type="button" class="btn" style="background: transparent; color: var(--text-muted);" onclick="closeInvoiceModal()">
                    Cancel & Close
                </button>
            </div>
        </div>
    </div>

    <script>
        let currentCurrency = 'NGN';
        let selectedPlanCode = 'monthly_standard';
        let currentInvoiceData = null;
        let subscriptionPlans = <?= json_encode($subscriptionTypes) ?>;

        function switchCurrency(currency) {
            currentCurrency = currency;
            document.querySelectorAll('.currency-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            subscriptionPlans.forEach(plan => {
                const priceElem = document.getElementById('price-' + plan.code);
                if (priceElem) {
                    if (currency === 'USD') {
                        priceElem.innerHTML = `$${plan.amount_usd.toFixed(2)} <span>/ month</span>`;
                    } else {
                        priceElem.innerHTML = `₦${plan.amount_ngn.toLocaleString('en-US', {minimumFractionDigits: 2})} <span>/ month</span>`;
                    }
                }
            });
        }

        function selectPlan(code) {
            selectedPlanCode = code;
            document.querySelectorAll('.plan-card').forEach(card => card.classList.remove('selected'));
            const selectedCard = document.getElementById('plan-card-' + code);
            if (selectedCard) selectedCard.classList.add('selected');
        }

        async function createPendingInvoice(userId, wardId, planCode) {
            try {
                const response = await fetch('/api/subscription/create-invoice', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        user_id: userId,
                        ward_id: wardId,
                        subscription_type_code: planCode,
                        currency: currentCurrency
                    })
                });

                const res = await response.json();
                if (!res.status) {
                    alert('Failed to generate invoice: ' + res.error);
                    return;
                }

                currentInvoiceData = res.invoice;

                // Populate Modal
                document.getElementById('modalInvoiceNumber').innerText = currentInvoiceData.invoice_number;
                document.getElementById('modalUserEmail').innerText = currentInvoiceData.user_email;
                document.getElementById('modalWardName').innerText = currentInvoiceData.ward_name;
                document.getElementById('modalPlanName').innerText = currentInvoiceData.subscription_type.name;
                document.getElementById('modalInvoiceStatus').innerText = currentInvoiceData.status.toUpperCase();
                
                const formattedAmt = currentInvoiceData.currency === 'USD' 
                    ? `$${currentInvoiceData.amount.toFixed(2)}`
                    : `₦${currentInvoiceData.amount.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
                document.getElementById('modalAmount').innerText = formattedAmt;

                document.getElementById('paymentAlert').style.display = 'none';
                document.getElementById('invoiceModal').classList.add('active');
            } catch (err) {
                alert('Error creating invoice: ' + err.message);
            }
        }

        function closeInvoiceModal() {
            document.getElementById('invoiceModal').classList.remove('active');
        }

        async function triggerPaystackPayment() {
            if (!currentInvoiceData) return;

            try {
                // Initialize transaction backend API
                const res = await fetch('/api/subscription/paystack-initialize', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        invoice_uuid: currentInvoiceData.uuid
                    })
                });

                const data = await res.json();
                if (!data.status) {
                    alert('Paystack initialization failed: ' + data.error);
                    return;
                }

                if (data.authorization_url) {
                    window.location.href = data.authorization_url;
                    return;
                }

                // Inline Paystack Popup
                const handler = PaystackPop.setup({
                    key: data.paystack_public_key,
                    email: currentInvoiceData.user_email,
                    amount: Math.round(currentInvoiceData.amount * 100),
                    currency: currentInvoiceData.currency,
                    ref: data.reference,
                    callback: function(response) {
                        verifyPaymentBackend(response.reference);
                    },
                    onClose: function() {
                        alert('Payment window closed.');
                    }
                });
                handler.openIframe();
            } catch (err) {
                alert('Paystack Checkout Error: ' + err.message);
            }
        }

        async function simulatePaystackSuccess() {
            if (!currentInvoiceData) return;
            const ref = currentInvoiceData.paystack_reference || ('SIM-' + currentInvoiceData.invoice_number);
            await verifyPaymentBackend(ref, true);
        }

        async function verifyPaymentBackend(reference, simulate = false) {
            try {
                const res = await fetch('/api/subscription/paystack-verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        reference: reference || currentInvoiceData.invoice_number,
                        simulate_success: simulate ? 1 : 0
                    })
                });

                const data = await res.json();
                if (data.status) {
                    document.getElementById('modalInvoiceStatus').innerText = 'PAID';
                    document.getElementById('modalInvoiceStatus').className = 'status-pill status-paid';
                    
                    const alertElem = document.getElementById('paymentAlert');
                    alertElem.style.display = 'block';
                    alertElem.innerHTML = `
                        <strong>🎉 Subscription Activated!</strong><br>
                        Payment verified via Paystack. Ward expiration date extended to: <strong>${data.ward.new_expire_date}</strong>.
                    `;

                    setTimeout(() => {
                        window.location.reload();
                    }, 3500);
                } else {
                    alert('Verification error: ' + data.error);
                }
            } catch (err) {
                alert('Verification call failed: ' + err.message);
            }
        }

        async function generateDemoToken() {
            try {
                const res = await fetch('/api/subscription/generate-token', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ user_id: 1, ward_id: 1 })
                });

                const data = await res.json();
                if (data.status) {
                    window.location.href = data.subscribe_url;
                } else {
                    alert('Could not generate token: ' + data.error);
                }
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }
    </script>
</body>
</html>
