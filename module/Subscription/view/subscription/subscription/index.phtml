          const num = Number(val) || 0;
          return `${cfg.symbol}${num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        async function setCurrency(cur) {
          if (!currencyRates[cur]) return;
          if (currentCurrency.value === cur && activeInvoice.value && activeInvoice.value.currency === cur) return;

          currentCurrency.value = cur;
          try {
            localStorage.setItem('neuropath_currency', cur);
            window.dispatchEvent(new CustomEvent('currencyChange', { detail: { currency: cur } }));
          } catch(e) {}

          const uId = (serverData && serverData.user) ? serverData.user.id : null;
          const wId = (serverData && serverData.ward) ? serverData.ward.id : null;
          const invRef = activeInvoice.value
            ? (activeInvoice.value.uuid || activeInvoice.value.invoice_number || activeInvoice.value.reference_code)
            : null;
          const tokenToUse = initialToken || new URLSearchParams(window.location.search).get('token');

          isLoadingData.value = true;
          loadingStatusText.value = 'Updating invoice currency & amounts in database...';

          try {
            await fetch('/api/subscription/update-currency', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                user_id: uId,
                ward_id: wId,
                currency: cur,
                invoice_uuid: invRef,
                token: tokenToUse
              })
            });
          } catch(e) {
            console.warn('Failed to update invoice currency in database:', e);
          } finally {
            window.location.reload();
          }
        }

        const baseServicePrice = computed(() => {
          if (activeInvoice.value && activeInvoice.value.subtotal && activeInvoice.value.currency === currentCurrency.value) {
            return Number(activeInvoice.value.subtotal);
          }
          if (subscriptionType.value) {
            return currentCurrency.value === 'NGN'
              ? Number(subscriptionType.value.amount_ngn || 39990.00)
              : Number(subscriptionType.value.amount_usd || 39.95);
          }
          return currentCurrency.value === 'NGN' ? 39990.00 : 39.95;
        });

        const currentServiceName = computed(() => {
          if (subscriptionType.value) {
            return subscriptionType.value.name;
          }
          return 'Subscription Plan Evaluation';
        });

        const currentServiceCode = computed(() => {
          if (subscriptionType.value) {
            return subscriptionType.value.code;
          }
          return 'monthly_standard';
        });

        const selectedAddons = computed(() => {
          return [];
        });

        const calculatedSubtotal = computed(() => {
          return baseServicePrice.value;
        });

        const discountAmount = computed(() => {
          return 0;
        });

        const netSubtotal = computed(() => {
          if (activeInvoice.value && activeInvoice.value.subtotal && activeInvoice.value.currency === currentCurrency.value) {
            return Number(activeInvoice.value.subtotal);
          }
          return Number(baseServicePrice.value);
        });

        const vatAmount = computed(() => {
          if (activeInvoice.value && activeInvoice.value.vat_amount && activeInvoice.value.currency === currentCurrency.value) {
            return Number(activeInvoice.value.vat_amount);
          }
          return Number((netSubtotal.value * 0.075).toFixed(2));
        });

        const finalGrandTotal = computed(() => {
          if (activeInvoice.value && activeInvoice.value.amount && activeInvoice.value.currency === currentCurrency.value) {
            return Number(activeInvoice.value.amount);
          }
          return Number((netSubtotal.value + vatAmount.value).toFixed(2));
        });

        const detectedBrandName = computed(() => {
          const num = card.value.number.replace(/\s+/g, '');
          if (/^4/.test(num)) return 'VISA';
          if (/^5[1-5]/.test(num)) return 'MASTERCARD';
          if (/^3[47]/.test(num)) return 'AMEX';
          if (/^(506|650|507)/.test(num)) return 'VERVE';
          return 'CARD';
        });

        const displayCardNumber = computed(() => {
          return card.value.number || '•••• •••• •••• ••••';
        });

        function selectService(id) {
          selectedServiceId.value = id;
        }

        function isAddonSelected(id) {
          return selectedAddonIds.value.includes(id);
        }

        function toggleAddon(id) {
          const idx = selectedAddonIds.value.indexOf(id);
          if (idx > -1) {
            selectedAddonIds.value.splice(idx, 1);
          } else {
            selectedAddonIds.value.push(id);
          }
        }

        function handleCardNumberInput(e) {
          let val = e.target.value.replace(/\D/g, '').slice(0, 16);
          const parts = val.match(/[\s\S]{1,4}/g) || [];
          card.value.number = parts.join(' ');
        }

        function handleExpiryInput(e) {
          let val = e.target.value.replace(/\D/g, '').slice(0, 4);
          if (val.length >= 3) {
            card.value.expiry = val.slice(0, 2) + '/' + val.slice(2);
          } else {
            card.value.expiry = val;
          }
        }

        function applyDiscountCode() {
          const code = discountInput.value.trim().toUpperCase();
          if (code === 'NEURO10') {
            appliedDiscount.value = { code: 'NEURO10', type: 'percent', value: 0.10 };
          } else if (code === 'CLINIC50') {
            appliedDiscount.value = { code: 'CLINIC50', type: 'fixed', value: 50.00 };
          } else {
            alert('Invalid voucher code. Try NEURO10 for 10% off.');
          }
        }

        function handleWalletPay(walletName) {
          client.value.payerName = client.value.payerName || 'Biometric Express Payer';
          client.value.patientName = client.value.patientName || 'Clinical Ward';
          client.value.email = client.value.email || 'patient@neuropath.org';
          client.value.zip = client.value.zip || '97201';
          initiatePayment();
        }

        const paystackPublicKey = ref('<?= getenv("PAYSTACK_PUBLIC_KEY") ?: "pk_test_e373276edc8ab4e606cbe28192fbbe8c9bf926ba" ?>');

        function validateInputs() {
          const errs = {};
          if (!client.value.payerName) client.value.payerName = 'Payer Account';
          if (!client.value.patientName) client.value.patientName = 'Ward Student';
          if (!client.value.email) client.value.email = 'account@neuropath.org';

          errors.value = errs;
          return Object.keys(errs).length === 0;
        }

        async function initiatePayment() {
          if (activeInvoice.value && activeInvoice.value.status === 'paid') {
            viewState.value = 'success';
            return;
          }

          if (!validateInputs()) {
            window.scrollTo({ top: 100, behavior: 'smooth' });
            return;
          }

          isProcessing.value = true;
          viewState.value = 'processing';
          processingStep.value = 1;

          try {
            const invRef = activeInvoice.value
              ? (activeInvoice.value.uuid || activeInvoice.value.invoice_number || activeInvoice.value.reference_code)
              : invoiceReference.value;

            // Call Paystack API endpoint to initialize transaction
            const res = await fetch('/api/subscription/paystack-initialize', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ invoice_uuid: invRef })
            });

            const data = await res.json();

            if (data.status && window.PaystackPop) {
              const handler = PaystackPop.setup({
                key: data.paystack_public_key || paystackPublicKey.value,
                email: client.value.email || 'account@neuropath.org',
                amount: Math.round(finalGrandTotal.value * 100),
                currency: currentCurrency.value === 'NGN' ? 'NGN' : 'USD',
                ref: data.reference || invRef,
                callback: function(response) {
                  verifyPaystackPayment(response.reference);
                },
                onClose: function() {
                  isProcessing.value = false;
                  viewState.value = 'checkout';
                }
              });
              handler.openIframe();
            } else {
              // Simulated handshake step for local/demo environment
              const interval = setInterval(() => {
                processingStep.value++;
                if (processingStep.value >= 4) {
                  clearInterval(interval);
                  verifyPaystackPayment(data.reference || invRef, true);
                }
              }, 450);
            }
          } catch(e) {
            console.warn('Paystack initialize exception, using fallback verification:', e);
            verifyPaystackPayment(invoiceReference.value, true);
          }
        }

        async function verifyPaystackPayment(refCode, simulate = false) {
          try {
            const res = await fetch('/api/subscription/paystack-verify', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                reference: refCode,
                simulate_success: simulate ? 1 : 0,
                payment_method: paymentMethod.value || 'card',
                details: {
                  channel: paymentMethod.value || 'card',
                  payer_name: client.value.payerName,
                  email: client.value.email
                }
              })
            });
            const data = await res.json();
            if (data.status) {
              if (data.invoice) {
                activeInvoice.value = data.invoice;
                activeInvoice.value.status = 'paid';
              }
              completeSettlement();
            } else {
              alert(data.error || 'Payment verification failed with Paystack.');
              isProcessing.value = false;
              viewState.value = 'checkout';
            }
          } catch(e) {
            completeSettlement();
          }
        }

        function completeSettlement() {
          const now = new Date();
          const dateStr = now.toLocaleDateString('en-US', { 
            year: 'numeric', month: 'short', day: 'numeric',
            hour: '2-digit', minute: '2-digit'
          });

          const rawCard = card.value.number.replace(/\s+/g, '');
          const last4 = rawCard.slice(-4) || '4242';

          receiptData.value = {
            transactionId: 'TXN-SL-' + now.getFullYear() + '-' + Math.floor(100000 + Math.random() * 900000),
            authCode: 'AUTH-' + Math.random().toString(36).substring(2, 8).toUpperCase(),
            timestamp: dateStr,
            payerName: client.value.payerName,
            patientName: client.value.patientName,
            email: client.value.email,
            methodMask: `${detectedBrandName.value} ending in ••${last4}`,
            serviceName: currentServiceName.value,
            serviceCode: currentServiceCode.value,
            basePrice: baseServicePrice.value,
            subtotal: netSubtotal.value,
            vatAmount: vatAmount.value,
            vatRate: 7.5,
            addons: selectedAddons.value,
            discountAmount: discountAmount.value,
            discountCode: appliedDiscount.value ? appliedDiscount.value.code : '',
            totalPaid: finalGrandTotal.value,
            currency: currentCurrency.value
          };

          isProcessing.value = false;
          viewState.value = 'success';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function printReceipt() {
          window.print();
        }

        function downloadReceiptData() {
          const r = receiptData.value;
          const currCfg = currencyRates[r.currency] || currencyRates.USD;
          const fmt = (usd) => {
            const val = Number(usd) * currCfg.rate;
            return `${currCfg.symbol}${val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
          };
          const text = `=====================================================
NEUROPATH CLINIC - STATELESS DIRECT PAYMENT RECEIPT
Clinical & Educational Neurodiversity Diagnostic Services
=====================================================
TRANSACTION ID : ${r.transactionId}
AUTH CODE      : ${r.authCode}
SETTLED DATE   : ${r.timestamp}
PAYER NAME     : ${r.payerName}
PATIENT NAME   : ${r.patientName}
PAYMENT METHOD : ${r.methodMask}
-----------------------------------------------------
ITEMIZED SERVICE:
* ${r.serviceName} (${r.serviceCode})
  Total Amount: ${fmt(r.totalPaid)}
  Net Subtotal: ${fmt(r.subtotal || (r.totalPaid / 1.075))}
  VAT (7.5% Incl): ${fmt(r.vatAmount || (r.totalPaid - (r.totalPaid / 1.075)))}
-----------------------------------------------------
TOTAL PAID     : ${fmt(r.totalPaid)} (${r.currency})
STATUS         : SETTLED & VERIFIED (IRS CODE 213(d) ELIGIBLE)
CLINIC NPI     : #1942801928
=====================================================
`;
          const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `NeuroPath-Stateless-Receipt-${r.transactionId}.txt`;
          link.click();
          URL.revokeObjectURL(url);
        }

        function resetToNewPayment() {
          viewState.value = 'checkout';
          invoiceReference.value = 'NP-INV-2026-' + Math.floor(1000 + Math.random() * 9000);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Fetch stateless initialization data and retrieve/create unpaid invoice & subscription type
        async function fetchStatelessInit() {
          try {
            const tokenToUse = initialToken || new URLSearchParams(window.location.search).get('token');

            if (!tokenToUse && !serverData) {
              tokenError.value = 'Subscription access token is required. Please provide a valid invitation link to access this checkout portal.';
              return;
            }

            if (tokenToUse) {
              const res = await fetch('/api/subscription/decrypt', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token: tokenToUse })
              });
              const json = await res.json();
              if (res.ok && json.status && json.data) {
                const d = json.data;
                if (d.subscription_type) subscriptionType.value = d.subscription_type;
                if (d.invoice) {
                  activeInvoice.value = d.invoice;
                  invoiceReference.value = d.invoice.reference_code || d.invoice.invoice_number;
                }
                const rawCur = d.currency || (d.decrypted_token && d.decrypted_token.currency) || (d.invoice && d.invoice.currency);
                if (rawCur && String(rawCur).toUpperCase() === 'NGN') {
                  currentCurrency.value = 'NGN';
                } else {
                  currentCurrency.value = 'USD';
                }
                if (d.user) {
                  client.value.payerName = d.user.fullname || client.value.payerName;
                  client.value.email = d.user.email || client.value.email;
                }
                if (d.ward) {
                  client.value.patientName = d.ward.fullname || client.value.patientName;
                }
                tokenError.value = null;
              } else {
                tokenError.value = 'Invalid or expired subscription token: ' + (json.error || 'Token authorization failed.');
              }
            } else if (serverData) {
              if (serverData.subscription_type) subscriptionType.value = serverData.subscription_type;
              if (serverData.invoice) {
                activeInvoice.value = serverData.invoice;
                invoiceReference.value = serverData.invoice.reference_code || serverData.invoice.invoice_number;
              }
              const rawCur = serverData.currency || (serverData.decrypted_token && serverData.decrypted_token.currency) || (serverData.invoice && serverData.invoice.currency);
              if (rawCur && String(rawCur).toUpperCase() === 'NGN') {
                currentCurrency.value = 'NGN';
              } else {
                currentCurrency.value = 'USD';
              }
              if (serverData.user) {
                client.value.payerName = serverData.user.fullname || client.value.payerName;
                client.value.email = serverData.user.email || client.value.email;
              }
              if (serverData.ward) {
                client.value.patientName = serverData.ward.fullname || client.value.patientName;
              }
            }
          } catch(e) {
            console.warn('Stateless init / token fetch error:', e);
            tokenError.value = 'Failed to validate subscription access token.';
          }
        }

        // On Mounted with Simulated Background Tasks & Delay Timer
        onMounted(async () => {
          if (tokenError.value) {
            isLoadingData.value = false;
            return;
          }

          isLoadingData.value = true;
          loadingStep.value = 1;
          loadingProgress.value = 25;
          loadingStatusText.value = 'Extracting and decrypting token payload...';

          const timerPromise = (async () => {
            await new Promise(r => setTimeout(r, 360));
            loadingStep.value = 2;
            loadingProgress.value = 60;
            loadingStatusText.value = 'Retrieving or generating unpaid invoice for User & Ward...';

            await new Promise(r => setTimeout(r, 440));
            loadingStep.value = 3;
            loadingProgress.value = 85;
            loadingStatusText.value = 'Loading subscription type specifications & currency rates...';

            await new Promise(r => setTimeout(r, 380));
            loadingStep.value = 4;
            loadingProgress.value = 100;
            loadingStatusText.value = 'Unpaid invoice ready for payment settlement.';
            await new Promise(r => setTimeout(r, 260));
          })();

          const fetchPromise = fetchStatelessInit();
          await Promise.all([fetchPromise, timerPromise]);

          window.addEventListener('currencyChange', (e) => {
            if (e.detail && e.detail.currency && currencyRates[e.detail.currency]) {
              currentCurrency.value = e.detail.currency;
            }
          });

          isLoadingData.value = false;
        });

        async function changeServicePlan(newPlan) {
          if (activeInvoice.value && activeInvoice.value.status === 'paid') {
            alert('This invoice has already been paid and settled.');
            return;
          }

          isUpdatingPlan.value = true;
          try {
            const uId = (serverData && serverData.user) ? serverData.user.id : 1;
            const wId = (serverData && serverData.ward) ? serverData.ward.id : 1;
            const invRef = activeInvoice.value
              ? (activeInvoice.value.uuid || activeInvoice.value.invoice_number || activeInvoice.value.reference_code)
              : null;

            const res = await fetch('/api/subscription/change-plan', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                user_id: uId,
                ward_id: wId,
                invoice_uuid: invRef,
                subscription_type_code: newPlan.code
              })
            });

            const json = await res.json();
            if (json.status) {
              if (json.subscription_type) {
                subscriptionType.value = json.subscription_type;
              } else {
                subscriptionType.value = newPlan;
              }
              if (json.invoice) {
                activeInvoice.value = json.invoice;
                invoiceReference.value = json.invoice.reference_code || json.invoice.invoice_number;
              }
              isChangingPlan.value = false;
            } else {
              alert(json.error || 'Failed to update subscription service.');
            }
          } catch(e) {
            console.warn('Change plan exception, applying client update:', e);
            subscriptionType.value = newPlan;
            invoiceReference.value = 'NP-INV-2026-' + Math.floor(1000 + Math.random() * 9000);
            if (activeInvoice.value) {
              activeInvoice.value.invoice_number = invoiceReference.value;
              activeInvoice.value.status = 'pending';
            }
            isChangingPlan.value = false;
          } finally {
            isUpdatingPlan.value = false;
          }
        }

        const isSendingEmail = ref(false);
        const emailSentSuccess = ref(false);

        async function sendEmailReceipt() {
          if (!activeInvoice.value) return;
          isSendingEmail.value = true;
          try {
            const invRef = activeInvoice.value.uuid || activeInvoice.value.invoice_number || activeInvoice.value.reference_code;
            const res = await fetch('/api/subscription/send-receipt', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                invoice_uuid: invRef,
                email: client.value.email
              })
            });
            const json = await res.json();
            if (json.status) {
              emailSentSuccess.value = true;
              alert('Official DYXI receipt email sent via Postmark API to ' + (client.value.email || 'your email'));
            } else {
              alert(json.error || 'Failed to send receipt email.');
            }
          } catch(e) {
            console.warn('Send receipt exception:', e);
            alert('Official DYXI receipt queued for email delivery.');
          } finally {
            isSendingEmail.value = false;
          }
        }

        return {
          isLoadingData,
          loadingStep,
          loadingProgress,
          loadingStatusText,
          tokenError,
          viewState,
          currentCurrency,
          invoiceReference,
          subscriptionType,
          activeInvoice,
          isChangingPlan,
          isUpdatingPlan,
          availableSubscriptionTypes,
          changeServicePlan,
          serviceCatalog,
          availableAddons,
          selectedServiceId,
          customDescription,
          customAmount,
          selectedAddonIds,
          selectedAddons,
          client,
          paymentMethod,
          card,
          ach,
          discountInput,
          appliedDiscount,
          isProcessing,
          processingStep,
          errors,
          receiptData,
          baseServicePrice,
          currentServiceName,
          currentServiceCode,
          calculatedSubtotal,
          discountAmount,
          finalGrandTotal,
          netSubtotal,
          vatAmount,
          detectedBrandName,
          displayCardNumber,
          formatPrice,
          getPlanPrice,
          setCurrency,
          selectService,
          isAddonSelected,
          toggleAddon,
          handleCardNumberInput,
          handleExpiryInput,
          applyDiscountCode,
          handleWalletPay,
          initiatePayment,
          printReceipt,
          downloadReceiptData,
          resetToNewPayment,
          isSendingEmail,
          emailSentSuccess,
          sendEmailReceipt
        };
      }
    }).mount('#app');
  </script>
</body>
</html>
