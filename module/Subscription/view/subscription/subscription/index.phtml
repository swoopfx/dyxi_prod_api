          if (plan.amount !== undefined && plan.currency === 'USD') return Number(plan.amount);
          return Number(plan.amount || 0);
        }

        // Currency format helper - formats value directly in selected currency without forcing USD conversion
        function formatPrice(val, currencyOverride = null) {
          const cur = currencyOverride || currentCurrency.value;
